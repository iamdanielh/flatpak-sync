#!/bin/bash
# Flatpak Sync - Auto-sync desktop files, icons, and Omarchy menu entries
# Part of the flatpak-sync Omarchy plugin

set -euo pipefail

DEST_DIR="$HOME/.local/share"
APPS_DIR="$DEST_DIR/applications"
ICONS_DIR="$DEST_DIR/icons/hicolor"
MENU_CFG="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

mkdir -p "$APPS_DIR"

# Copy desktop files
cp -f /var/lib/flatpak/exports/share/applications/*.desktop "$APPS_DIR/" 2>/dev/null || true

# Helper: copy a file resolving symlinks to real files
copy_real() {
  local src="$1" dst="$2"
  if [ -L "$src" ]; then
    cp -f "$(readlink -f "$src")" "$dst"
  elif [ -f "$src" ]; then
    cp -f "$src" "$dst"
  fi
}

# Sync icons from flatpak exports
for size in 64 128 256 512; do
  src="/var/lib/flatpak/exports/share/icons/hicolor/${size}x${size}"
  dst="$ICONS_DIR/${size}x${size}"
  [ -d "$src" ] || continue
  mkdir -p "$dst"
  for f in "$src"/*; do
    [ -f "$f" ] || [ -L "$f" ] || continue
    copy_real "$f" "$dst/$(basename "$f")"
  done
done

src="/var/lib/flatpak/exports/share/icons/hicolor/scalable"
dst="$ICONS_DIR/scalable"
if [ -d "$src" ]; then
  mkdir -p "$dst"
  for f in "$src"/*; do
    [ -f "$f" ] || [ -L "$f" ] || continue
    copy_real "$f" "$dst/$(basename "$f")"
  done
fi

# Sync appstream icons from flathub cache
for size in 64 128 256 512; do
  for dir in /var/lib/flatpak/appstream/flathub/x86_64/*/icons/${size}x${size}; do
    [ -d "$dir" ] || continue
    mkdir -p "$ICONS_DIR/${size}x${size}/apps"
    for f in "$dir"/*; do
      [ -f "$f" ] || [ -L "$f" ] || continue
      copy_real "$f" "$ICONS_DIR/${size}x${size}/apps/$(basename "$f")"
    done
  done
done

# Sync app icons from flatpak app exports
for dir in /var/lib/flatpak/app/*/x86_64/stable/*/export/share/icons/hicolor/scalable/apps; do
  [ -d "$dir" ] || continue
  mkdir -p "$ICONS_DIR/scalable/apps"
  for f in "$dir"/*; do
    [ -f "$f" ] || [ -L "$f" ] || continue
    copy_real "$f" "$ICONS_DIR/scalable/apps/$(basename "$f")"
  done
done

for dir in /var/lib/flatpak/app/*/x86_64/stable/*/export/share/icons/hicolor/*/apps; do
  [ -d "$dir" ] || continue
  size=$(basename "$(dirname "$dir")")
  mkdir -p "$ICONS_DIR/${size}/apps"
  for f in "$dir"/*; do
    [ -f "$f" ] || [ -L "$f" ] || continue
    copy_real "$f" "$ICONS_DIR/${size}/apps/$(basename "$f")"
  done
done

# Fix broken symlinks
find "$ICONS_DIR" -type l ! -exec test -e {} \; -delete 2>/dev/null || true

# Update caches
update-desktop-database "$APPS_DIR" 2>/dev/null || true
gtk-update-icon-cache -f "$ICONS_DIR" 2>/dev/null || true

# Auto-add new flatpak apps to Omarchy menu
mkdir -p "$(dirname "$MENU_CFG")"
if [ ! -f "$MENU_CFG" ]; then
  cat > "$MENU_CFG" << 'MENUEOF'
{
  "media": {"icon": "\uf008", "label": "Media"}
}
MENUEOF
fi

added=0
entries=""
_TMP=""
trap 'rm -f "$_TMP"' EXIT
for desktop in "$APPS_DIR"/*.desktop; do
  [ -f "$desktop" ] || continue
  grep -q "X-Flatpak" "$desktop" 2>/dev/null || continue

  app_id=$(basename "$desktop" .desktop)
  name=$(grep -m1 "^Name=" "$desktop" | cut -d= -f2)
  [ -z "$name" ] && continue

  # Skip apps already present in the menu
  grep -Fq "\"media.$app_id\"" "$MENU_CFG" 2>/dev/null && continue

  # Escape the name/id with a serializer before touching the config file
  key=$(jq -cn --arg k "media.$app_id" '$k') || exit 1
  value=$(jq -cn --arg name "$name" \
                --arg action "flatpak run $app_id" \
                '{"icon": "\uf019", "label": $name, "action": $action}') || exit 1
  entries="${entries}${key}: ${value}"$'\n'
  added=$((added + 1))
done

if [ "$added" -gt 0 ]; then
  _TMP="$(mktemp "$MENU_CFG.XXXXXX")"
  PYTHONIOENCODING=utf-8 ENTRIES="$entries" python3 - "$MENU_CFG" "$_TMP" <<'PY'
import json
import os
import sys

src, dst = sys.argv[1], sys.argv[2]
new_entries = [line for line in os.environ["ENTRIES"].splitlines() if line]

def without_line_comments(text):
    return "\n".join(line for line in text.splitlines()
                     if not line.lstrip().startswith("//"))

with open(src, encoding="utf-8") as f:
    original = f.read()

try:
    json.loads(without_line_comments(original))
except Exception as exc:
    print(f"flatpak-sync: refusing to edit invalid menu config: {exc}", file=sys.stderr)
    sys.exit(1)

lines = original.splitlines()
closing = next((i for i in range(len(lines) - 1, -1, -1)
                if lines[i].strip() == "}"), None)
if closing is None:
    print("flatpak-sync: cannot find closing brace in menu config", file=sys.stderr)
    sys.exit(1)

prefix = lines[:closing]
last = prefix[-1].rstrip()
if last and not last.endswith(","):
    prefix[-1] = prefix[-1].rstrip() + ","

prefix.append(",\n".join("  " + entry for entry in new_entries))
prefix.append(lines[closing])

new_text = "\n".join(prefix) + "\n"
json.loads(without_line_comments(new_text))

with open(dst, "w", encoding="utf-8") as f:
    f.write(new_text)
PY
  mv -f "$_TMP" "$MENU_CFG"
  echo "Added $added new app(s) to menu"
  omarchy restart shell 2>/dev/null || true
fi
